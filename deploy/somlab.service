[Unit]
Description=Somlab Diagnostics Django application
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=www-data
Group=www-data
WorkingDirectory=/var/www/somlab
EnvironmentFile=/etc/somlab.env
RuntimeDirectory=somlab
RuntimeDirectoryMode=0750
UMask=0027
ExecStart=/var/www/somlab/venv/bin/gunicorn config.wsgi:application \
    --bind unix:/run/somlab/gunicorn.sock \
    --workers 2 \
    --threads 2 \
    --timeout 7200 \
    --graceful-timeout 30 \
    --max-requests 1000 \
    --max-requests-jitter 100 \
    --access-logfile - \
    --error-logfile -
ExecReload=/bin/kill -s HUP $MAINPID
KillSignal=SIGQUIT
TimeoutStopSec=45
Restart=on-failure
RestartSec=5

# The code and secrets are readable but not writable by the web process. The
# database is the only persistent local path the application needs to change.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/somlab

[Install]
WantedBy=multi-user.target
