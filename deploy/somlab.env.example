# Copy to /etc/somlab.env, replace every placeholder, then chmod 640.
DJANGO_ENV_FILE=/etc/somlab.env
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
DJANGO_ALLOWED_HOSTS=somlab.so,www.somlab.so
DJANGO_CSRF_TRUSTED_ORIGINS=https://somlab.so,https://www.somlab.so
DJANGO_TRUST_PROXY_PROTO=1
DJANGO_HSTS_SECONDS=3600
DJANGO_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_HSTS_PRELOAD=0

DJANGO_DB_PATH=/var/lib/somlab/db.sqlite3
DJANGO_DB_TIMEOUT=20

R2_ENABLED=1
R2_BUCKET_NAME=somlab
R2_ENDPOINT_URL=https://REPLACE_WITH_ACCOUNT_ID.r2.cloudflarestorage.com
# Leave blank for private signed URLs, or use https://media.somlab.so only
# after that R2 custom domain works over HTTPS.
R2_PUBLIC_URL=
R2_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY
R2_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_KEY

DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_TIMEOUT=10
# Product-inquiry credentials are encrypted in the database and edited in Admin.
# Keep DJANGO_SECRET_KEY stable or the saved App Password cannot be decrypted.

CUSTOMER_VIDEO_PROCESSING_TIMEOUT=7200
