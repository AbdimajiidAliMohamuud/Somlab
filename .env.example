DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TRUST_PROXY_PROTO=0
DJANGO_HSTS_SECONDS=3600
DJANGO_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_HSTS_PRELOAD=0

# Optional SQLite location. Production should use /var/lib/somlab/db.sqlite3
# so deployments never overwrite the live database.
DJANGO_DB_PATH=
DJANGO_DB_TIMEOUT=20

# Cloudflare R2 media storage. Keep disabled for local filesystem development.
R2_ENABLED=0
R2_BUCKET_NAME=somlab
R2_ENDPOINT_URL=https://718f2e6da0406144b251608145fdad6b.r2.cloudflarestorage.com
# Leave empty for private, one-hour signed image URLs. Set a verified public
# custom domain for production. The current r2.dev endpoint returned HTTP 403.
R2_PUBLIC_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Product-inquiry SMTP host, sender and App Password are managed in Admin >
# Email Settings. Encryption uses DJANGO_SECRET_KEY: keep it stable and private.
# Use the console backend for local work and SMTP backend in production.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_TIMEOUT=10
DJANGO_DEFAULT_FROM_EMAIL=Somlab Website <info@somlab.so>
